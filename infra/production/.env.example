# Copy to infra/production/.env on the server. Never commit the real file.
BRIDGE_PORT=8000
PROVIDER_MODE=production

# Bridge persistence
SUBSCRIPTION_DB_PATH=/data/subscription_state.db

# Private Keygen endpoint (not public Internet)
KEYGEN_BASE_URL=http://keygen.internal:3000
KEYGEN_ACCOUNT_ID=REPLACE_WITH_PRODUCTION_ACCOUNT_ID
KEYGEN_TOKEN=REPLACE_WITH_PRODUCTION_TOKEN
KEYGEN_POLICY_ID=REPLACE_WITH_PRODUCTION_POLICY_ID
KEYGEN_HOST_HEADER=
KEYGEN_FORWARD_PROTO=https

# Billing webhook authentication
FOSSBILLING_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS

# Admin is intentionally local/private only; still use strong credentials.
SUBSCRIPTION_ADMIN_USER=ops
SUBSCRIPTION_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD_AT_LEAST_16_CHARS

# LIVE permit signing / release policy identity
SHUABAO_PERMIT_SIGNING_KEY_ID=prod-2026-09
SHUABAO_APPROVED_RELEASES_JSON=[]

# Optional operational identity
SERVICE_REVISION=REPLACE_WITH_DEPLOYED_GIT_SHA
